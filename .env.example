# ---------------------------------------------------------------
# Módulo Materias - variables de entorno LOCALES (opcionales)
# Copia a ".env" (está en .gitignore). docker compose lo lee solo;
# para "mvn spring-boot:run" exporta las mismas variables en tu terminal.
# ---------------------------------------------------------------

# Puerto de PostgreSQL en tu máquina (cámbialo si choca con la BD de otro módulo)
DB_PORT=5433

# S3 local (RustFS) para los PDFs. En AWS NO se definen S3_ENDPOINT, S3_FORCE_PATH_STYLE
# ni las claves AWS_*: el SDK usa el rol de la tarea y el bucket S3 privado real.
S3_BUCKET=materias-pdfs
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9100
S3_FORCE_PATH_STYLE=true
PDF_URL_TTL=10m
# Credenciales SOLO del S3 local (también son usuario/clave de su consola en :9101)
AWS_ACCESS_KEY_ID=materias_s3_local
AWS_SECRET_ACCESS_KEY=cambia_esta_clave_s3_local
